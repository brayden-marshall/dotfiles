  "tokenColors": [
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "foreground": "#585858",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Constant (Number, Boolean, Character, Float)",
      "scope": [
        "constant",
        "constant.numeric",
        "constant.character",
        "constant.language",
        "constant.language.boolean",
        "support.constant",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#9e9e9e"
      }
    },
    {
      "name": "Escapes & other special constants",
      "scope": [
        "constant.character.escape",
        "constant.other.placeholder",
        "constant.other.color"
      ],
      "settings": {
        "foreground": "#767676"
      }
    },
    {
      "name": "String",
      "scope": [
        "string",
        "punctuation.definition.string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#9e9e9e"
      }
    },
    {
      "name": "Regular expressions",
      "scope": [
        "string.regexp",
        "constant.other.character-class.regexp",
        "keyword.operator.or.regexp",
        "keyword.control.anchor.regexp"
      ],
      "settings": {
        "foreground": "#767676"
      }
    },
    {
      "name": "Identifier / variable",
      "scope": [
        "variable",
        "variable.other",
        "variable.other.readwrite",
        "meta.definition.variable.name",
        "support.variable",
        "entity.name.variable"
      ],
      "settings": {
        "foreground": "#808080"
      }
    },
    {
      "name": "Parameters",
      "scope": [
        "variable.parameter",
        "meta.parameter"
      ],
      "settings": {
        "foreground": "#808080",
        "fontStyle": "italic"
      }
    },
    {
      "name": "This / self / language variables",
      "scope": [
        "variable.language",
        "variable.language.this"
      ],
      "settings": {
        "foreground": "#808080",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Statement (Keyword, Conditional, Repeat, Operator word)",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.control.conditional",
        "keyword.control.loop",
        "keyword.control.flow",
        "keyword.control.import",
        "keyword.control.return",
        "keyword.other",
        "storage.type.function.arrow"
      ],
      "settings": {
        "foreground": "#b294c6"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator",
        "keyword.operator.assignment",
        "keyword.operator.arithmetic",
        "keyword.operator.logical",
        "keyword.operator.comparison",
