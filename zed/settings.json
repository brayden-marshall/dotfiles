{
  "cli_default_open_behavior": "new_window",
  "jsx_tag_auto_close": {
    "enabled": false
  },
  "icon_theme": {
    "mode": "dark",
    "light": "Zed (Default)",
    "dark": "Zed (Default)"
  },
  "format_on_save": "off",
  "git": {
    "inline_blame": {
      "enabled": false
    }
  },
  "base_keymap": "VSCode",
  "minimap": {
    "show": "never"
  },
  "buffer_line_height": "standard",
  "ui_font_family": ".ZedSans",
  "project_panel": {
    "dock": "left"
  },
  "buffer_font_family": "Consolas",
  "languages": {
    "HTML": {
      "jsx_tag_auto_close": {
        "enabled": false
      },
      "use_autoclose": false,
      "auto_indent": "syntax_aware"
    },
    "Python": {
      "format_on_save": "modifications_if_available"
    }
  },
  "session": {
    "trust_all_worktrees": true
  },
  "vim_mode": true,
  "ui_font_size": 14.0,
  "buffer_font_size": 14.0,
  "theme": {
    "mode": "dark",
    "light": "Gruvbox Light",
    "dark": "Nord Darker"
  },
  "terminal": {
    "font_size": 14.0,
    "detect_venv": {
      "on": {
        "directories": [
          ".venv",
          "venv",
          ".env",
          "env"
        ],
        "activate_script": "default"
      }
    }
  }
}
