{
  "completions": {
    "lsp_fetch_timeout_ms": 100
  },
  "agent": {
    "dock": "right",
    "favorite_models": [],
    "model_parameters": []
  },
  "agent_servers": {
    "claude-acp": {
      "default_config_options": {
        "model": "opus",
        "effort": "high",
        "mode": "auto",
        "fast": false
      },
      "type": "registry"
    }
  },
  "git_panel": {
    "group_by": "staging",
    "tree_view": true
  },
  "use_autoclose": true,
  "diff_view_style": "unified",
  "text_rendering_mode": "platform_default",
  "cli_default_open_behavior": "new_window",
  "jsx_tag_auto_close": {
    "enabled": false
  },
  "icon_theme": {
    "mode": "dark",
    "light": "Zed (Default)",
    "dark": "Zed (Default)"
  },
  "format_on_save": "off",
  "git": {
    "diff_base": "head",
    "inline_blame": {
      "enabled": false
    }
  },
  "base_keymap": "VSCode",
  "minimap": {
    "show": "never"
  },
  "buffer_line_height": "standard",
  "ui_font_family": ".ZedSans",
  "project_panel": {
    "dock": "left"
  },
  "buffer_font_family": "Consolas",
  "languages": {
    "TypeScript": {
      "language_servers": [
        "!tailwindcss-language-server",
        "..."
      ]
    },
    "TSX": {
      "tab_size": 4,
      "language_servers": [
        "!tailwindcss-language-server",
        "..."
      ]
    },
    "JavaScript": {
      "language_servers": [
        "!tailwindcss-language-server",
        "..."
      ]
    },
    "CSS": {
      "language_servers": [
        "!tailwindcss-language-server",
        "..."
      ]
    },
    "JSON": {
      "language_servers": [
        "!tailwindcss-language-server",
        "..."
      ]
    },
    "Shell Script": {
      "format_on_save": "off"
    },
    "HTML-Jinja": {
      "tab_size": 2,
      "use_autoclose": false,
      "language_servers": [
        "!biome"
      ]
    },
    "HTML": {
      "tab_size": 2,
      "jsx_tag_auto_close": {
        "enabled": false
      },
      "use_autoclose": false,
      "auto_indent": "syntax_aware",
      "language_servers": [
        "!biome"
      ]
    },
    "Python": {
      "completions": {
        "lsp_fetch_timeout_ms": 100
      },
      "inlay_hints": {
        "show_value_hints": false
      },
      "format_on_save": "modifications_if_available",
      "language_servers": [
        "!pylsp",
        "basedpyright",
        "ruff"
      ]
    }
  },
  "session": {
    "trust_all_worktrees": true
  },
  "vim_mode": true,
  "ui_font_size": 14.0,
  "buffer_font_size": 14.0,
  "theme": {
    "mode": "dark",
    "light": "Gruvbox Light Soft",
    "dark": "Warlock Arcane"
  },
  "lsp": {
    "vscode-html-language-server": {
      "settings": {
        "html": {
          "autoClosingTags": false
        }
      }
    },
    "vtsls": {
      "settings": {
        "typescript": {
          "tsserver": {
            "maxTsServerMemory": 3072,
            "useSyntaxServer": "never"
          },
          "disableAutomaticTypeAcquisition": true
        },
        "javascript": {
          "tsserver": {
            "maxTsServerMemory": 3072
          }
        }
      }
    }
  },
  "terminal": {
    "font_size": 14.0,
    "detect_venv": {
      "on": {
        "directories": [
          ".venv",
          "venv",
          ".env",
          "env"
        ],
        "activate_script": "default"
      }
    }
  },
  "file_scan_exclusions": [
    "**/.git",
    "**/node_modules",
    "**/.venv",
    "**/venv",
    "**/target",
    "**/dist",
    "**/.next",
    "**/__pycache__",
    "**/.pytest_cache",
    "**/.ruff_cache",
    "**/.mypy_cache"
  ]
}
