  "version": "1.2.1",
  "publisher": "brayden-marshall",
  "license": "MIT",
  "engines": {
    "vscode": "^1.70.0"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "warlock",
    "grayscale",
    "monochrome",
    "dark",
    "apprentice"
  ],
  "galleryBanner": {
    "color": "#262626",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hardselius/warlock"
  },
  "contributes": {
    "themes": [
      {
        "label": "Warlock",
        "uiTheme": "vs-dark",
